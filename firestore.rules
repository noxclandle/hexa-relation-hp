rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 各ポートフォリオLPの集計値 (hits, mip等)
    // 各LP自身がヒットカウント表示・MIP数表示のため公開読み取りが必要。
    // 訪問者による加算 (increment) も匿名で行われるため書き込みも公開のまま。
    match /analytics/{pageId} {
      allow read: if true;
      allow write: if true;
    }

    // ミニゲームのランキング (sabanomiso, choco/isshun)
    // スコア表示・投稿ともに匿名の一般訪問者が行うため公開のまま。
    match /leaderboard/{entryId} {
      allow read: if true;
      allow write: if true;
    }
    match /leaderboard_isshun/{entryId} {
      allow read: if true;
      allow write: if true;
    }

    // 訪問者ログ (User-Agent・リファラー等)。書き込み(記録)は公開のまま許可。
    // 閲覧は個人の閲覧環境が特定できる情報を含むため、管理画面の認証済みセッションのみに限定。
    match /visitor_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // 各LPへの流入(リファラー)ログ
    match /referrals/{pageId}/logs/{logId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // 依頼フォーム(/order/)の送信内容。氏名・連絡先・依頼内容という個人情報を含むため、
    // 送信(create)は公開のまま、閲覧は管理画面の認証済みセッションのみに限定。
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // 新規クライアント向けヒアリングフォームの回答。orders同様に個人情報を含む。
    match /client_intake/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // てんのページ(/save/ten2/)の掲示内容。ひとこと・週の配信枠・今後の予定。
    // ページ側が未ログインの訪問者に表示するため読み取りは公開。
    // 書き込みは /save/ten2/admin/ の認証済みセッションのみ。
    match /ten_board/{docId} {
      allow read: if true;
      // 裏ページ(/ten2/admin/)はあいことば＋匿名認証で入る運用。
      // 匿名認証は request.auth != null を満たすので、URLとあいことばを知っていれば
      // 誰でも書き換えられる。使い心地を優先したオーナーの判断による。
      allow write: if request.auth != null;
    }

    // てんへのおたより。ページの訪問者が匿名で送るため作成は公開。
    // 送信者名や相談内容を含むため、閲覧・既読・削除は裏ページの認証済みセッションのみ。
    match /ten_inbox/{docId} {
      // 送信は公開のまま。ただし形と量を縛って、無制限の流し込みを防ぐ。
      allow create: if request.resource.data.keys().hasOnly(['name','body','createdAt','read'])
                    && request.resource.data.body is string
                    && request.resource.data.body.size() > 0
                    && request.resource.data.body.size() <= 1000
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 40
                    && request.resource.data.read == false;
      // 閲覧も ten_board と同じ運用。匿名認証で読めるため、URLとあいことばを
      // 知っている人は誰でも中身を読める。表の文言は「このページの管理者が預かります」
      // としてあり、本人しか読まないとは約束していない。
      allow read, update, delete: if request.auth != null;
    }

    // 上記以外は全て非公開
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
